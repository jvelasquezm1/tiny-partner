{
  "name": "tiny-partner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI assistant for new parents: log feeds, sleep and diapers by chat, ask about your data or get answers grounded in cited pediatric guidance.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env src/rag/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:extraction": "tsx --env-file-if-exists=.env evals/extraction.ts",
    "eval:routing": "tsx --env-file-if-exists=.env evals/routing.ts",
    "eval:rag": "tsx --env-file-if-exists=.env evals/rag.ts"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@huggingface/transformers": "^4.3.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Used only when ANTHROPIC_API_KEY is empty: Gemini stands in for Claude
GEMINI_API_KEY=
# true: keyword rules instead of model calls, to try the bot without any key or spend
OFFLINE_MODE=false
# Optional: leave empty to run on Claude alone (no Jev routing, data shortcuts or RAG triage)
TYPESAFE_API_KEY=
# The admin page (list the indexed guides, re-run the ingest), on localhost only
ADMIN_PORT=4100
DATABASE_URL=postgres://tiny:tiny@localhost:5544/tiny_partner
# Comma-separated Telegram user ids allowed to talk to the bot (you + your partner)
ALLOWED_TELEGRAM_USER_IDS=
TZ=Europe/Madrid
